{
  "manifest_version": 3,
  "name": "My AI Trading (local)",
  "short_name": "My AI Trading",
  "version": "0.1.0",
  "description": "Market research side panel for the local My AI Trading engine. Live exchange accounts are read-only; orders go only to testnets after you confirm each one. No page scraping.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open My AI Trading side panel",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "alarms", "notifications"],
  "host_permissions": ["https://www.binance.com/*", "http://127.0.0.1:8765/*"]
}
