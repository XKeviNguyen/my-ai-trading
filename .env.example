# Sanitized example. Copy to .env (never commit .env). No value here is real.
# Market data needs no credentials: only public Binance endpoints are used.

# Optional AI copilot (pip install -e '.[ai]'). Leave unset to stay fully deterministic.
# Credentials for the AI SDK are read by the SDK from its own standard environment variables.
MY_AI_TRADING_MODEL=
# Optional USD prices per million tokens, used only to estimate spend in the usage dashboard:
# MY_AI_TRADING_PRICES={"<model id>": [input_usd_per_million, output_usd_per_million]}
MY_AI_TRADING_PRICES=

# Optional data/config locations (defaults: ~/.local/share/my-ai-trading, ~/.config/my-ai-trading)
# XDG_DATA_HOME=
# XDG_CONFIG_HOME=
