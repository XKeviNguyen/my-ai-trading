  "/api/v1/alerts": {
   "get": {
    "operationId": "alerts_api_v1_alerts_get",
    "parameters": [
     {
      "in": "query",
      "name": "after_seq",
      "required": false,
      "schema": {
       "default": 0,
       "minimum": 0,
       "title": "After Seq",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 100,
       "maximum": 500,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "header",
      "name": "authorization",
      "required": false,
      "schema": {
       "default": "",
       "title": "Authorization",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Alerts"
   }
  },
  "/api/v1/analysis": {
   "get": {
    "operationId": "analysis_api_v1_analysis_get",
    "parameters": [
     {
      "in": "query",
      "name": "symbol",
      "required": true,
      "schema": {
       "pattern": "^[A-Z0-9]{3,20}$",
       "title": "Symbol",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "market",
      "required": false,
      "schema": {
       "default": "usdm_perpetual",
       "enum": [
        "usdm_perpetual",
        "spot"
       ],
       "title": "Market",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "analysis_timeframe",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 4,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Analysis Timeframe"
      }
     },
     {
      "in": "query",
      "name": "timeframes",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Timeframes"
      }
     },
     {
      "in": "header",
      "name": "authorization",
      "required": false,
      "schema": {
       "default": "",
       "title": "Authorization",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "title": "Response Analysis Api V1 Analysis Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Analysis"
   }
  },
