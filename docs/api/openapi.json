      "discriminator": {
       "mapping": {
        "all": "#/components/schemas/AllOf",
        "any": "#/components/schemas/AnyOf",
        "compare": "#/components/schemas/Compare",
        "not": "#/components/schemas/Not",
        "trend": "#/components/schemas/Trend"
       },
       "propertyName": "kind"
      },
      "oneOf": [
       {
        "$ref": "#/components/schemas/Compare"
